  "notes": {
    "t_more": {"kind": "title1", "maxW": 3210, "page": "more", "text": "Settings, notifications, search, profile, reporting & Plus", "x": 0, "y": -300},
    "t_ops": {"kind": "title1", "maxW": 1440, "page": "more", "text": "Irbis for Operators (web)", "x": 0, "y": 1640},
    "n_report": {"fill": "red", "maxH": 340, "page": "more", "w": 390, "x": 1880, "y": 904, "text": "Moderation: 3 reports from trusted accounts (7+ days, verified phone) hide a post for everyone until the Irbis team reviews it, within 24 h. Strikes: warning → 7-day posting mute → ban, with appeal. Public groups over 500 members need 2+ admins; new accounts can post 3 times a day and can't share links or phone numbers."},
    "n_plus": {"fill": "orange", "maxH": 300, "page": "more", "w": 390, "x": 2820, "y": 1160, "text": "Irbis Plus: 29,000 so'm a month or 249,000 so'm a year, 7-day free trial — starting price to test. Never paywall safety, conditions, lessons or levels."},
    "t_feed": {"kind": "title1", "maxW": 2740, "page": "feed", "text": "Feed & Top Shots", "x": 0, "y": -300},
    "t_feed_a": {"kind": "title1", "maxW": 2740, "page": "feed", "text": "Post, browse, compete every two weeks", "x": 0, "y": 1440},
    "n_f_photos": {"fill": "teal", "maxH": 300, "page": "feed", "w": 390, "x": 940, "y": 2604, "text": "Picker opens on photos from the trip you just checked out of (matched by date). Max 10: an 11th tap shakes the counter. Upload continues in the background, even offline, and posts when back online."},
    "n_f_win": {"fill": "orange", "maxH": 300, "page": "feed", "w": 390, "x": 2350, "y": 2604, "text": "Shown on the first app open after results (Monday morning): the photo drops in, the rank badge stamps on, XP counts up, the badge flips in. Everyone in the Top 10 gets one push; nobody else is notified."},
    "t_camp": {"kind": "title1", "maxW": 3680, "page": "camp", "text": "Campfire games — offline multiplayer over one hotspot", "x": 0, "y": -300},
    "t_camp_a": {"kind": "title1", "maxW": 3680, "page": "camp", "text": "Host & join · Imposter · Who am I? · Would you rather", "x": 0, "y": 1700},
    "t_camp_b": {"kind": "title1", "maxW": 2270, "page": "camp", "text": "Mafia", "x": 0, "y": 3480},
    "n_c_join": {"fill": "teal", "maxH": 300, "page": "camp", "w": 390, "x": 940, "y": 2864, "text": "The QR holds the hotspot name + password and the room address (room code + host IP and port). One scan: join Wi-Fi, open the room. Code entry finds the host on the local network if the player joined the hotspot by hand."},
    "n_c_reveal": {"fill": "purple", "maxH": 300, "page": "camp", "w": 390, "x": 1410, "y": 2864, "text": "Hold to reveal: the secret shows only while a thumb is on the card, with a soft haptic tick. Screenshots are blocked on Android; on iOS the card blurs when screen recording is detected."},
    "n_c_wyr": {"fill": "orange", "maxH": 300, "page": "camp", "w": 390, "x": 3290, "y": 2864, "text": "Votes stay hidden until everyone has picked, then both bars fill at once with a short drumroll and the avatars drop into place."},
    "n_m_night": {"fill": "gray", "maxH": 320, "page": "camp", "w": 390, "x": 940, "y": 4644, "text": "Night: the app voice narrates (\"Mafia, wake up…\"). Every phone shows a night screen at the same time — players without an action get a quick tap task — so screen activity never gives a role away."},
    "n_m_day": {"fill": "red", "maxH": 300, "page": "camp", "w": 390, "x": 1410, "y": 4644, "text": "Day vote: majority exiles. A tie means a revote between the tied players; a second tie means nobody is exiled. The host can pause the timer."},
    "t_game": {"kind": "title1", "maxW": 3680, "page": "game", "text": "Bu qayer? — Where is this? mini-game", "x": 0, "y": -300},
    "n_g_round": {"fill": "orange", "maxH": 300, "page": "game", "w": 390, "x": 470, "y": 2624, "text": "360° viewer: drag/gyro to look around, pinch to zoom. The drag hint shows on the first round only. Compass needle follows the heading. The mini-map grows into the guess screen with a spring."},
    "n_g_result": {"fill": "orange", "maxH": 320, "page": "game", "w": 390, "x": 1410, "y": 2624, "text": "Reveal: the dashed line draws from your pin to the flag (0.6s), distance counts up, then points. Companion reacts by score: cheering ≥4,500, happy ≥3,000, thinking ≥1,500, worried below — never mocking."},
    "n_g_sum": {"fill": "orange", "maxH": 300, "page": "game", "w": 390, "x": 1880, "y": 2940, "text": "Daily complete: total rolls up, confetti, the streak flame grows by one. Share card is generated as an image with colored squares only — no place names, so it never spoils the daily."},
    "n_g_entry": {"fill": "teal", "maxH": 300, "page": "game", "w": 390, "x": 3290, "y": 2680, "text": "Retention hooks: a Home card every day, one 19:00 push (or the user's usual open time), the streak reminder only when the streak is at risk, and friend challenges as their own push. Max 1 game push per day."},
    "n_active": {
      "fill": "red",
      "maxH": 300,
      "page": "trips",
      "text": "Waypoint check-in: the ring fills and a +10 XP chip floats up. SOS needs a 3s press-and-hold with a radial progress ring, to avoid false alarms.",
      "w": 390,
      "x": 470,
      "y": 904
    },
    "n_chat": {
      "fill": "gray",
      "maxH": 260,
      "page": "social",
      "text": "Trip card status updates live. Companion avatars show the group's experience mix at a glance.",
      "w": 390,
      "x": 470,
      "y": 904
    },
    "n_home": {
      "fill": "orange",
      "maxH": 360,
      "page": "explore",
      "text": "Animations: tapping a node bounces it and opens a popover. A completed node flips to gold with a coin shower. On the red node, worried Irbis sways under the umbrella with rain particles. The weather shield on the streak pulses once when it protects the streak.",
      "w": 390,
      "x": 0,
      "y": 1700
    },
    "n_homedk": {
      "fill": "gray",
      "maxH": 260,
      "page": "explore",
      "text": "Dark mode: status rings switch to brighter tints so they keep 3:1 against #131D22; every status keeps its icon + label.",
      "w": 390,
      "x": 470,
      "y": 1700
    },
    "n_league": {
      "fill": "gray",
      "maxH": 260,
      "page": "learn",
      "text": "Sunday results: promotion rows shimmer green; demotion zone shows the sad-but-cute Irbis with a gentle message.",
      "w": 390,
      "x": 3290,
      "y": 1380
    },
    "n_lvlup": {
      "fill": "orange",
      "maxH": 300,
      "page": "learn",
      "text": "Evolution sequence (3s, skippable after 1s): old companion glows, hands over the backpack, white flash, new companion catches it and strikes a pose.",
