{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": [
      "../irbis-api",
      "../irbis-web",
      "../irbis-app"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/.next/**)",
      "Read(**/.expo/**)",
      "Read(**/coverage/**)",
      "Bash(git push:*)",
      "Bash(npx prisma db push:*)",
      "Bash(npx prisma migrate reset:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npx expo install:*)"
    ],
    "allow": [
      "Bash(adb devices:*)",
      "Bash(adb shell:*)",
      "Bash(adb exec-out:*)",
      "Bash(adb logcat:*)",
      "Bash(adb install:*)",
      "Bash(adb get-state:*)",
      "Bash(adb reverse:*)",
      "Bash(adb pull:*)",
      "Bash(scrcpy --version:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/block-secrets.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/check-changed.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
